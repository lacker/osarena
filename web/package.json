{
  "name": "penta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "pnpm run wasm:build",
    "dev": "node dev-server.js",
    "dev:url": "node worktree-port.js --url",
    "prebuild": "pnpm run wasm:build",
    "build": "pnpm run build:app",
    "build:app": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "pnpm run build && wrangler deploy -c dist/server/wrangler.json",
    "test": "make -C .. test-web-full",
    "test:all": "make -C .. test-web-full",
    "test:fast": "make -C .. test-web-fast",
    "test:wasm": "make -C .. test-web-wasm",
    "test:wasm:slow": "make -C .. test-web-wasm-slow",
    "test:render": "make -C .. test-web-render",
    "typecheck": "make -C .. typecheck-web",
    "check": "make -C .. check",
    "wasm:build": "../scripts/build-wasm.sh",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "packageManager": "pnpm@11.9.0",
  "type": "module"
}
